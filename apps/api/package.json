{
  "name": "@myrophone/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch --preload @sentry/bun/import src/index.ts",
    "start": "bun --preload @sentry/bun/import src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@myrophone/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/bun": "11.16.0",
    "@sentry/elysia": "11.16.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.8",
    "elysia": "^1.4.32",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "prisma": "7.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
