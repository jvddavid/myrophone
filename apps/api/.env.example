# Valores locais. Não use estes segredos em produção.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myrophone?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JWT_SECRET=myrophone-dev-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=*
LOG_HTTP_REQUESTS=true
LOG_LEVEL=info

# MinIO do docker-compose.yml. Usuário e senha são o padrão local do MinIO.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BUCKET=myrophone-public
S3_PRIVATE_BUCKET=myrophone-private
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/myrophone-public
