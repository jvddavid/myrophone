generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  OWNER
  ADMIN
  USER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  logoUrl     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lastSelectedBy User[]       @relation("UserLastTenant")
  roles       Role[]
  memberships Membership[]
  permissionTemplates CompanyPermissionTemplate[]
  teams       Team[]
  sessions    Session[]
  actionLogs  ActionLog[]
  storedFiles StoredFile[]
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  phone           String       @default("00000000")
  avatarUrl       String?
  emailVerifiedAt DateTime?
  passwordHash    String
  isActive        Boolean      @default(true)
  lastTenantId    String?
  lastTenant      Tenant?      @relation("UserLastTenant", fields: [lastTenantId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  sessions        Session[]
  actionLogs      ActionLog[]  @relation("ActorActionLogs")
  uploadedFiles   StoredFile[] @relation("StoredFileUploader")
  emailVerifications EmailVerification[]

  @@index([lastTenantId])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        RoleName
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  memberships Membership[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status    MembershipStatus @default(ACTIVE)
  teams     TeamMembership[]
  permissionGrants MembershipPermissionGrant[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([userId])
}

/// Defaults copied onto future ADMIN and USER members. OWNER is never stored.
model CompanyPermissionTemplate {
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          RoleName
  permissionKey String

  @@id([tenantId, role, permissionKey])
}

/// Effective grants for one membership. OWNER has none; the catalog is implied.
model MembershipPermissionGrant {
  membershipId  String
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permissionKey String

  @@id([membershipId, permissionKey])
}

enum TeamMembershipRole {
  LEADER
  MEMBER
}

model Team {
  id          String                   @id @default(cuid())
  tenantId    String
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  icon        String                   @default("folder")
  isActive    Boolean                  @default(true)
  members     TeamMembership[]
  permissions TeamPermissionAssignment[]
  actionLogs  ActionLog[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model TeamPermission {
  id          String                   @id @default(cuid())
  key         String                   @unique
  description String?
  teams       TeamPermissionAssignment[]
  createdAt   DateTime                 @default(now())
}

model TeamPermissionAssignment {
  teamId       String
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  permissionId String
  permission   TeamPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([teamId, permissionId])
  @@index([permissionId])
}

model TeamMembership {
  id           String             @id @default(cuid())
  teamId        String
  team          Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membershipId  String
  membership    Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role          TeamMembershipRole @default(MEMBER)
  createdAt     DateTime           @default(now())

  @@unique([teamId, membershipId])
  @@index([membershipId])
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model ActionLog {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  actorUserId String?
  actorUser   User?    @relation("ActorActionLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([teamId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
}

enum StoredFileVisibility {
  PUBLIC
  PRIVATE
}

enum StoredFilePurpose {
  AVATAR
  LOGO
  PUBLIC_IMAGE
  DOCUMENT
  VALIDATION
}

model StoredFile {
  id               String               @id @default(cuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedByUserId String?
  uploadedBy       User?                @relation("StoredFileUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  visibility       StoredFileVisibility
  purpose          StoredFilePurpose
  bucket           String
  objectKey        String
  originalName     String
  contentType      String
  sizeBytes        Int
  createdAt        DateTime             @default(now())

  @@unique([bucket, objectKey])
  @@index([tenantId])
  @@index([uploadedByUserId])
}
